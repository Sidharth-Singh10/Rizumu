<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's background: the cream the mark sits on.

  A flat fill rather than the old gradient. The mark is the artwork; the
  background's only job is to be the paper it is drawn on, and a gradient
  underneath it made the mark's own flat colours look muddy at mask edges.
  Matched to the cream the source artwork uses.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#F8F6EF"
        android:pathData="M0,0h108v108h-108z" />
</vector>
